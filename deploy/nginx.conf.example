# Example nginx configuration for tesla-hub. Replace example.com with your host names.
#
#   car.example.com       in-car menu, lyrics at /lyrics/ (TeslaMate can live here too)
#   bilibili.example.com  bilibili mirror (needs its own host name: bilibili's pages
#                         expect to sit at the root)
#
# Everything is behind a login (auth_request to oauth2-proxy, see oauth2-proxy.cfg.example).
# This is not optional: the mirror carries your bilibili login and the lyrics API has
# none. TLS is left out (terminate it here or in front, e.g. a Cloudflare tunnel).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ── shared login snippets ─────────────────────────────────────────────────────────
# (repeat per server, or move into an include file)

server {
    listen      80;
    server_name car.example.com;

    location ^~ /oauth2/ {
        proxy_pass       http://127.0.0.1:4180;
        proxy_set_header Host                    $host;
        proxy_set_header X-Forwarded-Proto       https;
        proxy_set_header X-Auth-Request-Redirect $request_uri;
    }
    location = /oauth2/auth {
        internal;
        proxy_pass              http://127.0.0.1:4180;
        proxy_set_header        Host              $host;
        proxy_set_header        X-Forwarded-Proto https;
        proxy_set_header        X-Forwarded-Uri   $request_uri;
        proxy_pass_request_body off;
        proxy_set_header        Content-Length    "";
    }
    location @signin {
        return 302 https://$host/oauth2/start?rd=https://$host$request_uri;
    }

    # in-car menu (static) and its optional link configuration
    location = / {
        auth_request /oauth2/auth;
        error_page 401 = @signin;
        root      /opt/tesla-hub/menu;
        try_files /index.html =404;
        add_header Cache-Control "no-cache" always;
    }
    location = /menu-config.js {
        auth_request /oauth2/auth;
        error_page 401 = @signin;
        root /opt/tesla-hub/menu;
        add_header Cache-Control "no-cache" always;
    }

    # lyrics (the page uses relative URLs, so any prefix works)
    location = /lyrics { return 301 https://$host/lyrics/; }
    location ^~ /lyrics/ {
        auth_request /oauth2/auth;
        error_page 401 = @signin;
        proxy_pass       http://127.0.0.1:8475/;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    # 继续观看 banner on the menu: the mirror's last video
    location = /bili-last {
        auth_request /oauth2/auth;
        error_page 401 = @signin;
        proxy_pass http://127.0.0.1:8490/__bili/last;
        add_header Cache-Control "no-store" always;
    }

    # TeslaMate / Grafana can be added here as well (TeslaMate with URL_PATH=/mate,
    # Grafana with GF_SERVER_SERVE_FROM_SUB_PATH=true).
}

server {
    listen      80;
    server_name bilibili.example.com;

    client_max_body_size 32M;

    location ^~ /oauth2/ {
        proxy_pass       http://127.0.0.1:4180;
        proxy_set_header Host                    $host;
        proxy_set_header X-Forwarded-Proto       https;
        proxy_set_header X-Auth-Request-Redirect $request_uri;
    }
    location = /oauth2/auth {
        internal;
        proxy_pass              http://127.0.0.1:4180;
        proxy_set_header        Host              $host;
        proxy_set_header        X-Forwarded-Proto https;
        proxy_set_header        X-Forwarded-Uri   $request_uri;
        proxy_pass_request_body off;
        proxy_set_header        Content-Length    "";
    }
    location @signin {
        return 302 https://$host/oauth2/start?rd=https://$host$request_uri;
    }

    location / {
        auth_request /oauth2/auth;
        error_page 401 = @signin;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie;

        proxy_pass         http://127.0.0.1:8490;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        $connection_upgrade;

        # video segments: stream straight through
        proxy_buffering         off;
        proxy_request_buffering off;
        proxy_read_timeout      3600s;
        proxy_send_timeout      3600s;
    }
}
