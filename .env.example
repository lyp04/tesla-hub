# tesla-hub configuration. Copy to .env (git-ignored) and fill in:
#     cp .env.example .env && chmod 600 .env

# ── Lyrics: TeslaMate access ────────────────────────────────────────────────────
# The lyrics service reads TeslaMate's encrypted Tesla access token from its database,
# so there is no second Tesla login. Take these from TeslaMate's own configuration.
TM_DB_HOST=database
TM_DB_NAME=teslamate
TM_DB_USER=teslamate
TM_DB_PASS=
TM_ENCRYPTION_KEY=
# TeslaMate's Docker network (docker network ls | grep teslamate)
TESLAMATE_NETWORK=teslamate_default
# Blank = the first car in TeslaMate; or one VIN
TESLA_VIN=

# ── Lyrics: options ─────────────────────────────────────────────────────────────
# Target language of the optional lyric translation (lyrics already in it are skipped)
TRANSLATE_TARGET_LANG=zh-CN
# Optional "wrong lyrics" button: files a GitHub issue (track, lyric source, timing offset;
# nothing personal). Needs a fine-grained token with "Issues: read and write" on that repo
# only. Leave blank to hide the button.
REPORT_GITHUB_REPO=
REPORT_GITHUB_TOKEN=
REPORT_GITHUB_LABEL=lyrics-mismatch

# ── bilibili mirror ─────────────────────────────────────────────────────────────
# Address of the in-car menu; pages get a small tab on the left edge back to it.
MENU_URL=
# Cookies of your login proxy in front of the mirror; never forwarded to bilibili
LOCAL_COOKIES=_oauth2_proxy

# ── Ports (both services have no login of their own: keep them on 127.0.0.1) ────
BIND_ADDR=127.0.0.1
LYRICS_PORT=8475
BILI_PORT=8490
